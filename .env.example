# Anthropic API Key for content generation
# Get your key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Runware API Key for image generation
# Get your key from: https://runware.ai/
RUNWARE_API_KEY=your_runware_api_key_here

# Amazon Associates Affiliate Tag
# Apply at: https://affiliate-program.amazon.com/
# Format: yourname-20 (replace with your actual tag after signup)
AMAZON_AFFILIATE_TAG=yourname-20

# YouTube Data API Key for video search
# Get your key from: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your_youtube_api_key_here

# SupaData API Key for transcript fallback
# Get your key from: https://supadata.ai/
SUPADATA_API_KEY=your_supadata_api_key_here
